# Banco. Sem DATABASE_URL, a API usa PGlite (Postgres em WASM) em
# ~/.recredita/pglite-dev — fora do repositório e do OneDrive — e, na subida,
# migra e semeia com dados sintéticos. O PGlite aceita um processo por vez:
# pare a API antes de rodar um CLI que abre o banco.
# DATABASE_URL="postgres://usuario:senha@host:5432/recredita"
# PGLITE_DIR=""

PORT="3001"

# Admin criado na subida se ainda não existir (qualquer ambiente). Mínimo de 12 caracteres.
ADMIN_EMAIL="admin@recredita.local"
ADMIN_SENHA=""

# Segredo do token CSRF. Obrigatório em produção (32+ caracteres); em
# desenvolvimento a API gera um efêmero.
# SEGREDO_SESSAO=""

# CAMILA. Em produção, Vertex AI pelo projeto do Google Cloud (contrato
# empresarial; o dado não treina o modelo). A chave do Gemini só vale fora de
# produção. Nenhuma das duas vai para o código do navegador.
# GOOGLE_CLOUD_PROJECT=""
# GOOGLE_CLOUD_LOCATION="southamerica-east1"
# GEMINI_API_KEY=""
# CAMILA_MODELO="gemini-3-flash-preview"

# Preparação do banco na subida (apps/api/src/principal.ts):
# - migrações sempre, salvo MIGRAR_NA_SUBIDA=nao (login da API sem permissão de DDL);
# - LOGIN_DA_API: papel que recebe recredita_app depois de migrar;
# - dados sintéticos só no PGlite ou com SEMEAR_DADOS_SINTETICOS=sim.
# MIGRAR_NA_SUBIDA="nao"
# LOGIN_DA_API="recredita_api"
# SEMEAR_DADOS_SINTETICOS="sim"

# Integrações (API Brasil, Evolution). As credenciais cadastradas na tela são
# cifradas no banco com esta chave (32+ caracteres). Sem ela, em produção, a
# chave deriva do SEGREDO_SESSAO — trocar qualquer uma das duas torna as
# credenciais guardadas ilegíveis (cadastre de novo).
# CHAVE_SEGREDOS=""
# Endereço público da API, para montar a URL do webhook da Evolution.
# URL_PUBLICA="https://central.recredita.com.br"
