{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "lint": {},
    "test": {
      "env": [
        "TEST_DATABASE_URL"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "agentGuidance": false
}
