# GEMINI_API_KEY: usada SOMENTE no servidor (server/index.ts).
# Nunca referencie esta chave em código sob src/: o Vite a inlina no bundle
# do cliente e ela fica legível no devtools de qualquer visitante.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: porta da API. O dev server do Vite faz proxy de /api para cá.
PORT="3001"

# DB_PATH: caminho do SQLite. Default: ./data.db
DB_PATH="./data.db"

# SENHA_INICIAL: usada SOMENTE por server/criar-usuario.ts, para não deixar
# senha no histórico do shell. Mínimo 12 caracteres. Remova depois de criar
# o primeiro admin.
SENHA_INICIAL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
